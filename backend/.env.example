# --- Neon (serverless Postgres, free tier: https://console.neon.tech) ---
# Copy the full connection string from your Neon project dashboard -- looks like:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require

# --- Google Gemini (free tier key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- Groq backup (free tier key: https://console.groq.com/keys) ---
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# --- App ---
ENV=development
